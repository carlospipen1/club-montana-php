# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Sistema PHP anterior: material de referencia local, no se publica.
# Contiene credenciales en texto plano y un SQLite con datos de socios.
legacy/

# Fotos subidas en desarrollo (en producción viven en Vercel Blob)
/public/subidas

# Fotos a la espera de subirse por el mantenedor
/fotos-para-subir
