# ---------------------------------------------------------------------------
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a git (está en .gitignore).
# ---------------------------------------------------------------------------

# Cadena de conexión de Neon Postgres.
# La sacas de: console.neon.tech -> tu proyecto -> Connection string
DATABASE_URL="postgresql://usuario:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar las cookies de sesión. Mínimo 32 caracteres.
# Genera uno nuevo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# Almacenamiento de las fotos de la galería. SOLO para desarrollo local:
# en Vercel el store va conectado al proyecto y se autentica por OIDC, sin token.
# Se obtiene creando un Blob Store en Vercel: Storage -> Create -> Blob, y
# copiando el valor desde la pestaña ".env.local" del store.
# Sin esta variable, en desarrollo las fotos se guardan en public/subidas/
# (útil para probar, pero no sirven en el sitio publicado).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Datos del primer administrador que crea el comando `npm run db:seed`.
SEED_ADMIN_EMAIL="tu-correo@ejemplo.cl"
SEED_ADMIN_PASSWORD="una-clave-larga-que-cambiaras-despues"
SEED_ADMIN_NOMBRES="Nombre"
SEED_ADMIN_APELLIDOS="Apellido"
